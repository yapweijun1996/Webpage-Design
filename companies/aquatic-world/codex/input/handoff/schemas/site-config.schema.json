{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/site-config.schema.json",
  "title": "Rebrandable Premium Landing Page Site Configuration",
  "type": "object",
  "required": [
    "contentStatus",
    "brand",
    "site",
    "navigation",
    "cta",
    "features"
  ],
  "properties": {
    "contentStatus": {
      "enum": [
        "DEMO_ONLY_NOT_APPROVED",
        "PRODUCTION_APPROVED"
      ]
    },
    "brand": {
      "type": "object",
      "required": [
        "name",
        "tagline"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string"
        },
        "logoAssetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "displayAsText": {
          "type": "boolean"
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "countryDisplayName": {
          "type": "string"
        },
        "cityDisplayName": {
          "type": "string"
        },
        "regionClaimApproved": {
          "type": "boolean"
        }
      }
    },
    "site": {
      "type": "object",
      "required": [
        "baseUrl",
        "defaultLocale",
        "locales"
      ],
      "properties": {
        "baseUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "defaultLocale": {
          "type": "string",
          "minLength": 2
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "themeId": {
          "type": "string"
        }
      }
    },
    "navigation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/navLink"
      }
    },
    "cta": {
      "type": "object",
      "required": [
        "primary",
        "secondary"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/action"
        },
        "secondary": {
          "$ref": "#/$defs/action"
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "enquiryEndpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacyPath": {
          "type": "string"
        }
      }
    },
    "legal": {
      "type": "object"
    },
    "socialLinks": {
      "type": "array"
    },
    "features": {
      "type": "object",
      "required": [
        "showProofPoints",
        "enableEnquiryForm"
      ],
      "properties": {
        "showProofPoints": {
          "type": "boolean"
        },
        "showQualitySection": {
          "type": "boolean"
        },
        "showHeritageQuote": {
          "type": "boolean"
        },
        "showLocaleSwitcher": {
          "type": "boolean"
        },
        "enableEnquiryForm": {
          "type": "boolean"
        },
        "showSocialLinks": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "pattern": "^(https://|/|mailto:)"
        }
      }
    },
    "navLink": {
      "type": "object",
      "required": [
        "id",
        "label",
        "href"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "pattern": "^(https://|/|mailto:)"
        }
      }
    }
  },
  "additionalProperties": false
}
